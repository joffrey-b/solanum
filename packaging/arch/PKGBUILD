# Maintainer: joffrey-b <https://github.com/joffrey-b>
#
# This PKGBUILD is intended to be driven by the GitHub Actions release
# workflow, not built standalone from an unpacked tarball. CI stamps the
# real version into pkgver at build time and drops the prebuilt Linux
# binary + .desktop + icon + licence files next to this file before
# invoking makepkg, so package() can install straight from $startdir
# with no source= / download step.
#
# If you want to build it yourself: copy the release binary into this
# directory as `solanum`, copy solanum.desktop, icon.png, LICENSE,
# NOTICE and THIRD-PARTY-LICENSES.txt in, then run `makepkg -f`.

pkgname=solanum
pkgver=0.0.0
pkgrel=1
pkgdesc='A modern, secure SSH/SFTP desktop client'
arch=('x86_64')
url='https://github.com/joffrey-b/solanum'
license=('GPL-3.0-only')
# Runtime libs the Tauri release binary links against. webkit2gtk-4.1 +
# gtk3 + libsoup3 match the same triple the AppImage/.deb depends on.
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3')
optdepends=('libayatana-appindicator: system-tray icon support')
# The binary is already stripped ([profile.release] in src-tauri/Cargo.toml);
# running makepkg's strip pass again is a no-op and just slows the build.
options=('!strip')

package() {
  install -Dm755 "$startdir/solanum"         "$pkgdir/usr/bin/solanum"
  install -Dm644 "$startdir/solanum.desktop" "$pkgdir/usr/share/applications/solanum.desktop"
  install -Dm644 "$startdir/icon.png"        "$pkgdir/usr/share/icons/hicolor/512x512/apps/solanum.png"
  install -Dm644 "$startdir/LICENSE"         "$pkgdir/usr/share/licenses/solanum/LICENSE"
  install -Dm644 "$startdir/NOTICE"          "$pkgdir/usr/share/licenses/solanum/NOTICE"
  install -Dm644 "$startdir/THIRD-PARTY-LICENSES.txt" "$pkgdir/usr/share/licenses/solanum/THIRD-PARTY-LICENSES.txt"
}
