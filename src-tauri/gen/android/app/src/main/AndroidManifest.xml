<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Foreground service permissions: while SSH sessions are open, a
        foreground service keeps the process (and the sessions in it) alive
        when Solanum is in the background (ConnectionKeeperService, KeepAlive).
        FOREGROUND_SERVICE is the base permission (Android 9+);
        FOREGROUND_SERVICE_SPECIAL_USE is what Android 14+ checks for the
        specialUse type the service uses there. Below 14 it uses dataSync,
        which needs no permission of its own there. Both are granted at install.
        POST_NOTIFICATIONS: Android 13+ shows the service's notification only
        once the user allows it; Solanum asks once, at the first session.
        Declined, the service still runs and the notification stays hidden.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!--
        allowBackup="false" + dataExtractionRules disables Android's Auto Backup
        (Android 6+) and Device-to-Device transfer / cloud restore (Android 12+).
        Without this, /data/data/io.github.joffrey_b.solanum/{files,databases,shared_prefs}
        (which holds the encrypted vault and any cached SSH state) rides Google's automatic backup to the user's Drive
        and to any device they sign in to. For an SSH client that's a silent
        credential leak — an SSH client vault export is exactly what an
        attacker who compromised the Google account would want. Better to make
        the user re-configure than to let secrets ride the OS backup pipe.
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.solanum"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
            windowSoftInputMode="adjustResize|stateHidden"
              adjustResize: THE load-bearing keyboard fix. Without this the Android
              WebView stays at the pre-keyboard height and the on-screen kb draws
              over the terminal + MobileKeyBar. CSS alone (100dvh, or a
              JS-synced viewport-height custom prop) is unreliable on WebView
              versions before Chromium M139 (mid-2025)
              because visualViewport.height there equals layoutViewport.height
              per MDN — so JS can't detect the kb either. adjustResize shrinks
              the whole Activity window so 100vh / flex-1 / etc. do the right
              thing automatically on every Android version we support.
              stateHidden: the kb should NOT auto-open on resume/rotate.
            NOTE: this file lives under gen/android/ and IS regenerated when
            someone runs `tauri android init`. If that happens, re-apply this
            attribute; Tauri 2 has no way to declare softInputMode in
            tauri.conf.json today.

            configChanges lists every change Android 16 (SDK 36) defines but
            resourcesUnused (F-032). A recreated Activity gets a new WebView,
            and the frontend's start-up locks the profile and ends every
            session, so a font-size, display-size or wallpaper change
            (assetsPaths, dynamic colours) must not recreate it. The WebView
            lays itself out again on its own.
            tests/scripts/android-manifest.test.mjs checks this file.
        -->
        <activity
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|grammaticalGender|fontScale|fontWeightAdjustment|assetsPaths"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ConnectionKeeperService: runs while the window has SSH sessions
            open (KeepAlive), with a notification saying so, so that Android
            does not kill the process while the user is in another app. All
            SSH/SFTP state lives in the Rust backend inside this process. It
            stops at the last session, when the Activity is destroyed (other
            than for a configuration change: Tauri then exits and ends every
            session), or when Solanum is swiped away from Recents.
            Type: specialUse on Android 14+ (no time limit; dataSync gets 6
            hours a day on Android 15+), dataSync on 10 to 13 (F-004). The
            property is the reason specialUse requires.
        -->
        <service
            android:name=".ConnectionKeeperService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's open SSH sessions (terminals, file transfers and port forwards) connected while the app is in the background, until the user closes them." />
        </service>
    </application>
</manifest>
